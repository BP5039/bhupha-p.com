---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Bhupha Phanphaeng">
  <main class="container nf">
    <p class="code">404</p>
    <h1>This page doesn't exist (yet).</h1>
    <p>The site is still growing. Try the <a href="/">home page</a>.</p>
    <p lang="ja">お探しのページは見つかりませんでした。<a href="/yipeng">ランタンのページはこちら</a>。</p>
  </main>
</Base>

<style>
  .nf { padding-top: 18vh; padding-bottom: 10vh; }
  .code { font-size: 14px; font-weight: 700; letter-spacing: 0.1em; color: var(--ink-soft); margin: 0; }
</style>

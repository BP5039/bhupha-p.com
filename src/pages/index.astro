---
import Base from '../layouts/Base.astro';
---
<Base title="Bhupha Phanphaeng">
  <main class="container hero">
    <h1>Bhupha Phanphaeng</h1>
    <p>Software Engineering student at CAMT, Chiang Mai University. I build full-stack web apps with Vue, TypeScript and Firebase.</p>
    <p class="soon">Full site coming soon.</p>
    <nav class="links" aria-label="Elsewhere">
      <a href="https://github.com/BP5039">GitHub</a>
      <a href="https://www.linkedin.com/in/bhupha-phanphaeng/">LinkedIn</a>
    </nav>
  </main>
</Base>

<style>
  /* Styles in a .astro file only apply to this page. */
  .hero { padding-top: 18vh; padding-bottom: 10vh; }
  h1 { font-size: clamp(2rem, 6vw, 3rem); }
  .soon { color: var(--ink-soft); }
  .links { display: flex; gap: 20px; margin-top: 24px; }
  .links a { padding: 10px 0; font-weight: 600; }
</style>

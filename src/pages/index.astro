---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Short "what I'm doing now" items. Edit this list to update the strip.
const now = [
  'Finishing TamBaan, my senior project',
  'Japan Capstone, 22-27 Nov 2026',
  'Looking for internships',
];
---
<Base title="Bhupha Phanphaeng - Software Engineering student, Chiang Mai">
  <main>
    <section class="container wide hero">
      <p class="eyebrow">Software Engineering · CAMT, Chiang Mai University</p>
      <h1>Hi, I'm Bhupha.</h1>
      <p class="lead">I build full-stack web apps with Vue, TypeScript and Firebase, and I care about how they feel to use.</p>
      <div class="actions">
        <a class="btn primary" href="#work">See my work</a>
        <a class="btn" href="https://github.com/BP5039">GitHub</a>
      </div>
    </section>

    <section class="now" aria-label="Now">
      <div class="container wide now-inner">
        <span class="eyebrow">Now</span>
        <ul>
          {now.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section id="work" class="container wide block">
      <h2>Featured work</h2>
      <div class="grid">
        <ProjectCard
          title="TamBaan"
          summary="A two-sided marketplace connecting Thai homeowners with renovation professionals. Senior project."
          tags="Vue 3 · TypeScript · Firebase · Tailwind"
          tint="var(--blue)"
          note="Case study coming in December."
        />
        <ProjectCard
          title="Japan Capstone 2026"
          summary="A study trip to Osaka, Kobe and Tokyo, with a Thai craft workshop and Yi Peng lantern gifts for our hosts."
          tags="Workshop design · Japanese + English"
          tint="var(--pink)"
          href="/work/japan-capstone/yipeng"
          linkLabel="Read the lantern page"
        />
      </div>
    </section>

    <section id="contact" class="container wide block">
      <h2>Get in touch</h2>
      <p class="lead">Open to internships and collaborations.</p>
      <div class="actions">
        <a class="btn" href="https://www.linkedin.com/in/bhupha-phanphaeng/">LinkedIn</a>
        <a class="btn" href="https://github.com/BP5039">GitHub</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { padding-top: clamp(56px, 12vh, 120px); padding-bottom: clamp(40px, 8vh, 80px); }
  h1 { font-size: clamp(2.4rem, 8vw, 4rem); line-height: 1.1; margin: 8px 0 16px; }
  h2 { font-size: clamp(1.5rem, 4vw, 2rem); margin-bottom: 20px; }
  .lead { font-size: clamp(1.05rem, 2.4vw, 1.25rem); max-width: 36em; margin: 0; }
  .eyebrow {
    margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--terracotta);
  }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .btn {
    display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px;
    border: 1.5px solid var(--navy); border-radius: 12px;
    color: var(--navy); text-decoration: none; font-weight: 700;
  }
  .btn:hover { background: var(--navy); color: var(--cream); }
  .btn.primary { background: var(--navy); color: var(--cream); }
  .btn.primary:hover { background: var(--terracotta); border-color: var(--terracotta); color: #fff; }

  .now { background: #fff; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .now-inner { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 32px; padding-top: 18px; padding-bottom: 18px; }
  .now ul { display: flex; flex-wrap: wrap; gap: 6px 32px; list-style: none; margin: 0; padding: 0; font-size: 16px; }

  .block { padding-top: clamp(48px, 9vh, 88px); }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
</style>

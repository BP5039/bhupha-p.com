---
// One project on the home page (and later on /work).
// With an href the whole card is a link; without one it shows a "coming soon" note.
interface Props {
  title: string;
  summary: string;
  tags: string;
  tint: string;
  href?: string;
  linkLabel?: string;
  note?: string;
}

const { title, summary, tags, tint, href, linkLabel, note } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="card" href={href} data-tilt>
  <div class="thumb" style={`background:${tint}`} aria-hidden="true">{title}</div>
  <div class="body">
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <p class="tags">{tags}</p>
    {href && <p class="more">{linkLabel} →</p>}
    {!href && note && <p class="note">{note}</p>}
  </div>
</Tag>

<script>
  // Cards lean slightly toward the mouse and lift. Mouse only, and off when the
  // visitor has asked their device for reduced motion.
  const canTilt =
    window.matchMedia('(hover: hover)').matches &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canTilt) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (event) => {
        const box = card.getBoundingClientRect();
        const x = (event.clientX - box.left) / box.width - 0.5;
        const y = (event.clientY - box.top) / box.height - 0.5;
        card.style.transform = `perspective(800px) rotateY(${x * 6}deg) rotateX(${y * -6}deg) translateY(-4px)`;
      });
      card.addEventListener('pointerleave', () => {
        card.style.transform = '';
      });
    });
  }
</script>

<style>
  .card {
    display: flex; flex-direction: column;
    background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; color: var(--ink); text-decoration: none;
    transition: transform 0.2s ease-out, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  a.card:hover { border-color: var(--accent); color: var(--ink); }
  .card:hover { box-shadow: 0 16px 32px -22px rgba(15, 20, 31, 0.5); }
  .thumb {
    height: 150px; display: flex; align-items: flex-end; padding: 16px 20px;
    font-size: 28px; font-weight: 700; color: var(--heading);
  }
  .body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  h3 { margin: 0; font-size: 20px; }
  p { margin: 0; }
  .summary { font-size: 16px; line-height: 1.55; }
  .tags { font-size: 14px; color: var(--ink-soft); }
  .more { margin-top: auto; padding-top: 8px; font-weight: 700; color: var(--accent); }
  .note { margin-top: auto; padding-top: 8px; font-size: 14px; color: var(--ink-soft); }
</style>

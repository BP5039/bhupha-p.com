---
// Site-wide navigation. Only links that already lead somewhere are listed;
// add a line here as each new page goes live.
import ThemeToggle from './ThemeToggle.astro';
import Signature from './Signature.astro';
const links = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Resume' },
  { href: '/#contact', label: 'Contact' },
];
// Mark the link for the page being viewed (and its sub-pages).
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => !href.includes('#') && (path === href || path.startsWith(href + '/'));
---
<header class="nav">
  <div class="container wide nav-inner">
    <a class="brand" href="/" aria-label="Bhupha Phanphaeng, home"><Signature label="Bhupha Phanphaeng" /></a>
    <nav aria-label="Main">
      <ul>
        {links.map((link) => (
          <li><a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 10;
    background: var(--nav-bg);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner { display: flex; align-items: center; gap: 8px 20px; min-height: 60px; }
  .brand { margin-right: auto; }
  .brand { display: flex; align-items: center; height: 44px; padding: 6px 0; color: var(--heading); text-decoration: none; transition: transform 0.2s ease; }
  .brand:hover { transform: rotate(-3deg) scale(1.04); }
  @media (prefers-reduced-motion: reduce) { .brand:hover { transform: none; } }
  ul { display: flex; gap: 4px 24px; flex-wrap: wrap; list-style: none; margin: 0; padding: 0; }
  li a {
    display: inline-flex; align-items: center; min-height: 44px;
    color: var(--heading); text-decoration: none; font-weight: 600; font-size: 15px;
  }
  li a:hover, .brand:hover { color: var(--accent-hover); }
  li a:hover, li a[aria-current='page'] { text-decoration: underline; text-underline-offset: 6px; }
  li a[aria-current='page'] { text-decoration-thickness: 2px; }

  /* Phones: links move to their own row under the name and theme button. */
  @media (max-width: 600px) {
    .nav-inner { flex-wrap: wrap; padding-top: 6px; padding-bottom: 2px; }
    nav { order: 3; flex-basis: 100%; }
    ul { justify-content: space-between; gap: 0; }
  }
</style>

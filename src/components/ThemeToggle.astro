---
// Theme control with three choices: Auto (follow the device), Light, Dark.
// Desktop shows a three-way switch; tablets and phones show one button that cycles.
// Icons: screen = Auto, sun = Light, moon = Dark.
// The choice is saved and applied before paint by the inline script in Base.astro.
---
<button class="theme-toggle" type="button" data-theme-cycle aria-label="Theme: Auto">
  <svg class="icon show-auto" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
  <svg class="icon show-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  <svg class="icon show-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
</button>

<div class="theme-switch" role="radiogroup" aria-label="Theme">
  <button type="button" role="radio" data-theme-set="auto" aria-label="Auto, follow my device">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
  </button>
  <button type="button" role="radio" data-theme-set="light" aria-label="Light">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
  </button>
  <button type="button" role="radio" data-theme-set="dark" aria-label="Dark">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
  </button>
</div>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const names = { auto: 'Auto', light: 'Light', dark: 'Dark' } as const;
  type Pref = keyof typeof names;

  const pref = (): Pref => (root.dataset.themePref as Pref) || 'auto';
  const resolve = (p: Pref) => (p === 'auto' ? (media.matches ? 'dark' : 'light') : p);

  let animTimer: number | undefined;
  function set(p: Pref) {
    // Fade the whole page at one speed while the colors change.
    root.classList.add('theme-anim');
    clearTimeout(animTimer);
    animTimer = window.setTimeout(() => root.classList.remove('theme-anim'), 350);
    root.dataset.themePref = p;
    root.dataset.theme = resolve(p);
    try { localStorage.setItem('theme', p); } catch {}
    sync();
    window.dispatchEvent(new CustomEvent('themechange'));
  }
  function sync() {
    const p = pref();
    document.querySelectorAll('[data-theme-cycle]').forEach((b) => {
      b.setAttribute('aria-label', `Theme: ${names[p]}. Click to change.`);
      b.setAttribute('title', `Theme: ${names[p]}`);
    });
    document.querySelectorAll<HTMLElement>('[data-theme-set]').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.themeSet === p));
    });
  }
  // Fixed order, same as the three-way switch: Auto, Light, Dark, then back to Auto.
  const order: Pref[] = ['auto', 'light', 'dark'];
  const next = (): Pref => order[(order.indexOf(pref()) + 1) % order.length];
  document.querySelectorAll('[data-theme-cycle]').forEach((b) => b.addEventListener('click', () => set(next())));
  document.querySelectorAll<HTMLElement>('[data-theme-set]').forEach((b) =>
    b.addEventListener('click', () => set(b.dataset.themeSet as Pref)),
  );
  media.addEventListener('change', () => { if (pref() === 'auto') set('auto'); });
  // Re-read the saved choice whenever this page comes back into view. Covers pages the
  // browser restored from its Back/Forward cache or prepared ahead of time, which can
  // still carry the theme from before the choice changed on another page or tab.
  function syncFromStorage() {
    let saved: Pref = 'auto';
    try {
      const t = localStorage.getItem('theme');
      if (t === 'light' || t === 'dark') saved = t;
    } catch {}
    root.dataset.themePref = saved;
    root.dataset.theme = resolve(saved);
    sync();
  }
  syncFromStorage();
  window.addEventListener('pageshow', syncFromStorage);
  window.addEventListener('pagereveal', syncFromStorage);
  window.addEventListener('storage', (e) => { if (e.key === 'theme') syncFromStorage(); });
  document.addEventListener('visibilitychange', () => { if (!document.hidden) syncFromStorage(); });
  document.addEventListener('prerenderingchange', syncFromStorage);
</script>

<style>
  .theme-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; padding: 0; flex: none;
    border: 1px solid var(--line); border-radius: 999px;
    background: transparent; color: var(--heading); cursor: pointer;
  }
  .theme-toggle:hover { border-color: var(--highlight); }
  .icon { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  /* Show the icon for the current choice: screen = Auto, sun = Light, moon = Dark. */
  .theme-toggle .icon { display: none; }
  :global(html[data-theme-pref='light']) .theme-toggle .show-light,
  :global(html[data-theme-pref='dark']) .theme-toggle .show-dark,
  :global(html:not([data-theme-pref='light']):not([data-theme-pref='dark'])) .theme-toggle .show-auto { display: block; }

  .theme-switch { display: none; flex: none; padding: 3px; gap: 2px; border: 1px solid var(--line); border-radius: 999px; }
  .theme-switch button {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; padding: 0; border: 0; border-radius: 999px;
    background: transparent; color: var(--ink-soft); cursor: pointer;
  }
  .theme-switch .icon { width: 17px; height: 17px; }
  .theme-switch button:hover { color: var(--heading); }
  .theme-switch button[aria-checked='true'] { background: var(--surface); color: var(--heading); box-shadow: inset 0 0 0 1px var(--line); }
  /* Desktop: the three-way switch. Tablets and phones: the single button. */
  @media (min-width: 901px) {
    .theme-toggle { display: none; }
    .theme-switch { display: inline-flex; }
  }
  .theme-toggle:focus-visible, .theme-switch button:focus-visible { outline: 3px solid var(--highlight); outline-offset: 2px; }
</style>

  <path d="M60 20 L24 52 M60 20 L96 52" stroke="currentColor" stroke-width="5" stroke-linecap="round" fill="none" />
  <rect x="24" y="50" width="72" height="6" rx="2" fill="currentColor" />
  <rect x="28" y="56" width="64" height="176" fill="#ffffff" stroke="currentColor" stroke-width="2" />
  <g>
    <rect x="29" y="96" width="62" height="14" fill="#ead9b0" />
    <path d="M29 108 L45 98 L60 108 L75 98 L91 108" stroke="#c9a24a" stroke-width="1.5" fill="none" />
    <rect x="29" y="114" width="62" height="12" fill="#2e8b57" />
    <rect x="29" y="130" width="62" height="14" fill="#ead9b0" />
    <path d="M29 142 L45 132 L60 142 L75 132 L91 142" stroke="#c9a24a" stroke-width="1.5" fill="none" />
    <rect x="29" y="148" width="62" height="12" fill="#b4462f" />
    <rect x="29" y="164" width="62" height="14" fill="#ead9b0" />

  <g fill="#f3ead2" stroke="#c9a24a" stroke-width="1">
    <circle cx="24" cy="120" r="5" /><circle cx="96" cy="120" r="5" />
    <circle cx="24" cy="154" r="5" /><circle cx="96" cy="154" r="5" />
    <circle cx="24" cy="188" r="5" /><circle cx="96" cy="188" r="5" />
  </g>
